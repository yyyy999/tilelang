// Single-AIV vexp microbench for cannsim record.
// Usage: ./vexp_kernel_bench [n_iters]
// Each iteration loads a distinct 64-lane UB tile, vexp, and stores back.
// Per-iter loads are required: identical vexp(x) is CSE'd to one instruction.

#include "acl/acl.h"
#include "kernel_operator.h"

#include <stdio.h>
#include <stdlib.h>

#define CHECK_ACL(expr)                                                        \
  do {                                                                         \
    aclError s = (expr);                                                       \
    if (s != ACL_SUCCESS) {                                                    \
      fprintf(stderr, "ACL error %d at %s:%d: %s\n", (int)(s), __FILE__,       \
              __LINE__, #expr);                                                \
      exit(1);                                                                 \
    }                                                                          \
  } while (0)

constexpr int kLanes = 64;
constexpr int kMaxIters = 128;

__simd_vf__ inline void vexp_loop(__ubuf__ float *ub, int n_iters) {
  vector_bool mask = pset_b32(PAT_ALL);
  vector_f32 x;
  vector_f32 y;
#pragma clang loop unroll(disable)
  for (int i = 0; i < n_iters; ++i) {
    ::vlds(x, ub + i * kLanes, 0, NORM);
    ::vexp(y, x, mask, MODE_ZEROING);
    ::vsts(y, ub + i * kLanes, 0, NORM_B32, mask);
  }
}

extern "C" __global__ __vector__ void vexp_bench_kernel(__gm__ float *src,
                                                       __gm__ float *dst,
                                                       int n_iters) {
  if (n_iters > kMaxIters)
    n_iters = kMaxIters;
  const uint32_t elems = static_cast<uint32_t>(kMaxIters * kLanes);

  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> ub_buf;
  pipe.InitBuffer(ub_buf, elems * static_cast<uint32_t>(sizeof(float)));
  AscendC::LocalTensor<float> ub = ub_buf.Get<float>();
  AscendC::GlobalTensor<float> gm_src;
  AscendC::GlobalTensor<float> gm_dst;
  gm_src.SetGlobalBuffer(src, elems);
  gm_dst.SetGlobalBuffer(dst, elems);

  AscendC::DataCopy(ub, gm_src, elems);
  AscendC::PipeBarrier<PIPE_ALL>();

  vexp_loop(reinterpret_cast<__ubuf__ float *>(ub.GetPhyAddr()), n_iters);

  AscendC::PipeBarrier<PIPE_ALL>();
  AscendC::DataCopy(gm_dst, ub, elems);
}

int main(int argc, char **argv) {
  int n_iters = 64;
  if (argc >= 2)
    n_iters = atoi(argv[1]);
  if (n_iters <= 0) {
    fprintf(stderr, "usage: %s [n_iters>0]\n", argv[0]);
    return 1;
  }
  if (n_iters > kMaxIters)
    n_iters = kMaxIters;

  CHECK_ACL(aclInit(nullptr));
  CHECK_ACL(aclrtSetDevice(0));
  aclrtStream stream = nullptr;
  CHECK_ACL(aclrtCreateStream(&stream));

  const size_t bytes =
      (size_t)kMaxIters * (size_t)kLanes * sizeof(float);
  void *d_src = nullptr;
  void *d_dst = nullptr;
  CHECK_ACL(aclrtMalloc(&d_src, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
  CHECK_ACL(aclrtMalloc(&d_dst, bytes, ACL_MEM_MALLOC_HUGE_FIRST));

  float *host = (float *)malloc(bytes);
  if (!host)
    return 1;
  for (size_t i = 0; i < bytes / sizeof(float); ++i)
    host[i] = 0.1f;
  CHECK_ACL(aclrtMemcpy(d_src, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE));

  vexp_bench_kernel<<<1, 0, stream>>>((__gm__ float *)d_src, (__gm__ float *)d_dst,
                                      n_iters);
  CHECK_ACL(aclrtSynchronizeStream(stream));

  printf("vexp_kernel done n_iters=%d lanes=%d\n", n_iters, kLanes);

  free(host);
  CHECK_ACL(aclrtFree(d_src));
  CHECK_ACL(aclrtFree(d_dst));
  CHECK_ACL(aclrtDestroyStream(stream));
  CHECK_ACL(aclrtResetDevice(0));
  CHECK_ACL(aclFinalize());
  return 0;
}
