# from tvm.script import tirx as T

@T.prim_func
def main(A_handle: T.handle):
    A = T.match_buffer(A_handle, (256, 64), "bfloat16", strides=(64, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            l1 = T.handle("bfloat16", "shared.l1")
            T.sblock_attr({"tl.buffer_version_mode": {l1: "counter"}, "tl.buffer_versions_map": {l1: 3}})
            l1_1 = T.sblock_alloc_buffer((64, 64), "bfloat16", data=l1, scope="shared.l1")
            l0 = T.sblock_alloc_buffer((64, 64), "bfloat16", scope="shared.l0a")
            for i in T.serial(4, annotations={"enable_offset": True, "multi_buffer_eligible": [l1_1], "num_stages": 3}):
                T.ascend_copy(T.region(A[i * 64, 0], 1, 64, 64), T.region(l1_1[0, 0], 2, 64, 64))
                T.ascend_copy(T.region(l1_1[0, 0], 1, 64, 64), T.region(l0[0, 0], 2, 64, 64))
