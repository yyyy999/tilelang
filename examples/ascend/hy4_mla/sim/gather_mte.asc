// Hy4 gather microbench. One AIV, the target tile only.
// A 64-token KV tile is 32 rows on this sub-core, each row 576 bf16.
// mode 0 issues 16 copies of 2x576, the current gather_kv pattern.
// mode 1 issues one copy of 32x576, the same bytes in one DMA.
// Usage: ./gather_mte_bench [0|1]

#include "acl/acl.h"
#include "kernel_operator.h"

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#define CHECK_ACL(expr)                                                        \
  do {                                                                         \
    aclError s = (expr);                                                       \
    if (s != ACL_SUCCESS) {                                                    \
      fprintf(stderr, "ACL error %d at %s:%d: %s\n", (int)(s), __FILE__,       \
              __LINE__, #expr);                                                \
      exit(1);                                                                 \
    }                                                                          \
  } while (0)

constexpr int kDim = 576;
constexpr int kRows = 32;
constexpr int kPairs = 16;
constexpr int kPairRows = 2;
constexpr int kGapRows = 64;
constexpr int kSrcRows = kPairs * kGapRows;

extern "C" __global__ __vector__ void gather_mte_kernel(__gm__ uint16_t *src,
                                                       __gm__ uint16_t *dst,
                                                       int mode) {
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> ub_buf;
  pipe.InitBuffer(ub_buf, kRows * kDim * static_cast<uint32_t>(sizeof(uint16_t)));
  AscendC::LocalTensor<uint16_t> ub = ub_buf.Get<uint16_t>();
  AscendC::GlobalTensor<uint16_t> gm_src;
  AscendC::GlobalTensor<uint16_t> gm_dst;
  gm_src.SetGlobalBuffer(src, kSrcRows * kDim);
  gm_dst.SetGlobalBuffer(dst, kRows * kDim);

  AscendC::PipeBarrier<PIPE_ALL>();
  if (mode == 0) {
#pragma clang loop unroll(disable)
    for (int i = 0; i < kPairs; ++i) {
      AscendC::DataCopy(ub[i * kPairRows * kDim], gm_src[i * kGapRows * kDim],
                        kPairRows * kDim);
    }
  } else {
    AscendC::DataCopy(ub, gm_src, kRows * kDim);
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  AscendC::DataCopy(gm_dst, ub, kRows * kDim);
}

int main(int argc, char **argv) {
  int mode = 0;
  if (argc >= 2)
    mode = atoi(argv[1]);
  if (mode != 0 && mode != 1) {
    fprintf(stderr, "usage: %s [0=pair|1=contiguous]\n", argv[0]);
    return 1;
  }

  CHECK_ACL(aclInit(nullptr));
  CHECK_ACL(aclrtSetDevice(0));
  aclrtStream stream = nullptr;
  CHECK_ACL(aclrtCreateStream(&stream));

  const size_t src_bytes = (size_t)kSrcRows * kDim * sizeof(uint16_t);
  const size_t dst_bytes = (size_t)kRows * kDim * sizeof(uint16_t);
  void *d_src = nullptr;
  void *d_dst = nullptr;
  CHECK_ACL(aclrtMalloc(&d_src, src_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
  CHECK_ACL(aclrtMalloc(&d_dst, dst_bytes, ACL_MEM_MALLOC_HUGE_FIRST));

  uint16_t *host = (uint16_t *)malloc(src_bytes);
  if (!host)
    return 1;
  for (size_t i = 0; i < src_bytes / sizeof(uint16_t); ++i)
    host[i] = (uint16_t)(i & 0xffff);
  CHECK_ACL(aclrtMemcpy(d_src, src_bytes, host, src_bytes, ACL_MEMCPY_HOST_TO_DEVICE));

  gather_mte_kernel<<<1, 0, stream>>>((__gm__ uint16_t *)d_src,
                                      (__gm__ uint16_t *)d_dst, mode);
  CHECK_ACL(aclrtSynchronizeStream(stream));
  printf("hy4_gather_mte done mode=%d rows=%d dim=%d\n", mode, kRows, kDim);

  free(host);
  CHECK_ACL(aclrtFree(d_src));
  CHECK_ACL(aclrtFree(d_dst));
  CHECK_ACL(aclrtDestroyStream(stream));
  CHECK_ACL(aclrtResetDevice(0));
  CHECK_ACL(aclFinalize());
  return 0;
}
